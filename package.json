{
  "name": "ai-qa-playground",
  "version": "0.1.0",
  "private": true,
  "description": "AI QA playground: Playwright E2E + Midscene.js + pytest 单测 + 最小 ReAct 循环",
  "scripts": {
    "serve": "python -m game.server --port 8100",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report reports/playwright",
    "test:midscene": "npm --prefix tests/e2e-midscene run test:midscene"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
